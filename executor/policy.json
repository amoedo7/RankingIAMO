{
  "schema_version": "1.0",
  "name": "EjecutorIAMO",
  "default_budget_eur": 0,
  "max_prospects_per_iamo": 3,
  "max_outreach_per_hour": 5,
  "max_outreach_per_day": 20,
  "recipient_cooldown_days": 30,
  "allowed_actions": [
    "generate_static_landing",
    "generate_product_zip",
    "publish_offer_in_repository",
    "prepare_personalized_outreach",
    "send_outreach_through_authorized_adapter",
    "check_verified_payment_ledger"
  ],
  "forbidden_actions": [
    "transfer_existing_amo_funds",
    "trading",
    "gambling",
    "borrowing",
    "credential_access",
    "mass_spam",
    "purchased_contact_lists",
    "deceptive_identity",
    "fabricated_payment_evidence"
  ],
  "outreach": {
    "public_business_contact_required": true,
    "external_evidence_url_required": true,
    "personalization_required": true,
    "identify_as_desarrollamo": true,
    "opt_out_required": true,
    "automatic_followups": false
  },
  "payments": {
    "destination": "https://cobramo.netlify.app/",
    "reference_format": "RANK-IAMO<n>",
    "score_source": "data/earnings.jsonl",
    "unverified_claims_score": "0.00"
  },
  "public_offer_base": "https://raw.githack.com/amoedo7/RankingIAMO/main/offers/"
}
